# Copy to .env locally. Never paste an API key into chat or commit it.
OPENAI_API_KEY=
# Set a model available to your API account that supports Responses structured outputs.
OPENAI_MODEL=
# Optional: local web answer model. No API key is required.
OLLAMA_MODEL=qwen3:4b-instruct
# Set to 0 for retrieval-only deployments that cannot reach a host Ollama server.
OLLAMA_ENABLED=1

# Spring Boot application backend (local development defaults shown here).
DB_URL=jdbc:postgresql://127.0.0.1:5432/edu_rag
DB_USERNAME=edu_rag
DB_PASSWORD=edu_rag_local
AI_SERVICE_URL=http://127.0.0.1:8765
